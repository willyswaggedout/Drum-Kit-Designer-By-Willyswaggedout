{
  "name": "drum-kit-designer",
  "productName": "Drum Kit Designer",
  "version": "1.2.0",
  "description": "Build custom FL Studio drum kits: folders, .nfo files, label images and banners. By @Willyswaggedout.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.willyswaggedout.drumkitdesigner",
    "productName": "Drum Kit Designer",
    "files": [
      "app/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "willyswaggedout",
        "repo": "Drum-Kit-Designer-By-Willyswaggedout"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Drum Kit Designer",
      "artifactName": "Drum-Kit-Designer-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "copyright": "By @Willyswaggedout"
  },
  "author": "@Willyswaggedout",
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
